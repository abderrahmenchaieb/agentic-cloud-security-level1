# =============================================================================
# CONTENEUR — BUS RÉSEAU + DASHBOARD
# =============================================================================
# Le dashboard est servi PAR le bus (mêmes routes FastAPI, même WebSocket) :
# les séparer imposerait un aller-retour réseau pour des vues qui se
# nourrissent directement du flux du bus.
#
# Ce conteneur ne charge AUCUN modèle : ni torch ni scikit-learn.
# =============================================================================
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY docker/requirements-bus.txt /tmp/
RUN pip install --no-cache-dir -r /tmp/requirements-bus.txt && rm /tmp/requirements-bus.txt

COPY dashboard_realtime/ /app/dashboard_realtime/

ENV PYTHONUNBUFFERED=1 PYTHONPATH=/app:/app/dashboard_realtime
EXPOSE 8000

HEALTHCHECK --interval=10s --timeout=3s --start-period=15s --retries=3 \
    CMD curl -fs http://localhost:8000/health || exit 1

WORKDIR /app/dashboard_realtime
CMD ["python", "run_bus.py"]
